        // Funzione per mostrare o nascondere tutte le soluzioni
        function toggleAllSolutions(show) {
            const containers = document.querySelectorAll('.solution-container');
            const buttons = document.querySelectorAll('.btn-toggle');

            containers.forEach((container, index) => {
                if (show) {
                    container.classList.add('visible');
                    buttons[index].textContent = 'Nascondi Soluzione';
                } else {
                    container.classList.remove('visible');
                    buttons[index].textContent = 'Mostra Soluzione';
                }
            });
        }
    </script>
</body>
</html>
